# InfraFlow Environment Configuration Example

# Django Settings
DEBUG=True
SECRET_KEY=infraflow-development-secret-key-change-in-production-2026
ALLOWED_HOSTS=localhost,127.0.0.1,web,backend,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://infraflow_user:infraflow_password@postgres:5432/infraflow_db
POSTGRES_DB=infraflow_db
POSTGRES_USER=infraflow_user
POSTGRES_PASSWORD=infraflow_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis / Celery Configuration
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# Object Storage Configuration (Local in Dev / S3 Compatible in Prod)
STORAGE_BACKEND=local
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=infraflow-documents

# Email / Notification Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=notifications@infraflow.demo.in

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8000/api/v1
